{
  "name": "giloa-protected-build",
  "private": true,
  "version": "1.0.0",
  "description": "Key-gated protected distribution builder for Giloa",
  "scripts": {
    "protect": "node tools/protected-build.mjs",
    "protect:check": "node tools/protected-build.mjs --check",
    "features:build": "node tools/build-feature-sources.mjs --write",
    "features:check": "node tools/build-feature-sources.mjs --check",
    "features:find": "node tools/build-feature-sources.mjs --find",
    "test:features": "node --test tests/feature-layout.test.cjs",
    "preprotect": "npm run features:check",
    "preprotect:check": "npm run features:check"
  },
  "devDependencies": {
    "clean-css": "5.3.3",
    "html-minifier-terser": "7.2.0",
    "javascript-obfuscator": "4.1.1",
    "terser": "5.43.1"
  }
}
